# Database
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_MODE=required

# Authentication
JWT_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# External mail delivery and receiving (Resend HTTPS API)
MAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_DOMAIN=example.com
RESEND_FROM_ADDRESS=
MAIL_PUBLIC_DOMAIN=example.com
MAIL_ALLOW_CLASSIFIED_EXTERNAL=false

# Optional local SMTP fallback. Render Free blocks SMTP ports.
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER=noreply@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false
